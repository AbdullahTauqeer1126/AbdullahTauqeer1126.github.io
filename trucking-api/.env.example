# Example environment for trucking-api
PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@db:5432/trucking
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change_this_in_production
REDIS_URL=redis://redis:6379
SUPABASE_URL=
SUPABASE_KEY=
PORT=3001
NODE_ENV=production

# Database (optional: API can start without DB, but features may degrade)
DB_HOST=localhost
DB_PORT=5432
DB_USER=trucking_user
DB_PASSWORD=CHANGE_ME
DB_NAME=trucking_db

# Auth
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Supabase (required for most API features)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional (server-side admin queries)
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# CORS
# CORS_ORIGIN=https://your-frontend-domain.com
