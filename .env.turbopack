# Turbopack Optimization for Next.js 16.2.4 with Supabase Auth
# Reduces aggressive module reloading that causes token lock race conditions

# Increase memory allocation for Turbopack
TURBOPACK_MEMORY_LIMIT=4096

# Disable prefetching to reduce hot-reload cycles
NEXT_TURBOPACK_DISABLE_PREFETCH=1

# Disable aggressive module reloading
TURBOPACK_RECHECK_ON_CONTENT_CHANGE=0

# Development environment (Turbopack optimizations apply)
NODE_ENV=development
