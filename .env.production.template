# ============================================
# TRUCKING APP - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.local or .env.production
# and fill in your actual values

# ========== NODE & APP CONFIG ==========
NODE_ENV=production
PORT=3001
APP_NAME=Trucking Platform
APP_URL=https://yourdomain.com
LOG_LEVEL=info

# ========== DATABASE - SUPABASE POSTGRESQL ==========
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE=your-supabase-service-role-key

# ========== JWT & SECURITY ==========
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ========== FIREBASE - NOTIFICATIONS ==========
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYourFirebasePrivateKeyHere\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ========== PAYMENT GATEWAYS ==========

# JazzCash
JAZZCASH_MERCHANT_ID=your-jazzcash-merchant-id
JAZZCASH_PASSWORD=your-jazzcash-password
JAZZCASH_MERCHANT_NAME=Trucking Platform
JAZZCASH_MERCHANT_URL=https://yourdomain.com
JAZZCASH_CALLBACK_URL=https://yourdomain.com/api/payments/jazzcash/callback

# EasyPaisa
EASYPAISA_MERCHANT_ID=your-easypaisa-merchant-id
EASYPAISA_PASSWORD=your-easypaisa-password
EASYPAISA_STORE_ID=your-store-id
EASYPAISA_CALLBACK_URL=https://yourdomain.com/api/payments/easypaisa/callback

# Stripe (Optional)
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-public-key

# ========== SMS & COMMUNICATIONS ==========

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS (SMS Alternative)
AWS_SNS_REGION=us-east-1
AWS_SNS_ACCESS_KEY_ID=your-aws-key
AWS_SNS_SECRET_ACCESS_KEY=your-aws-secret

# ========== EMAIL SERVICE ==========

# SendGrid
SENDGRID_API_KEY=SG.your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Alternative: SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ========== REDIS CACHE ==========
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# ========== UPLOAD & STORAGE ==========

# AWS S3
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=trucking-uploads
AWS_S3_ACCESS_KEY=your-access-key
AWS_S3_SECRET_KEY=your-secret-key

# ========== LOCATION SERVICES ==========

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-key

# OpenWeather (Optional - for weather data)
OPENWEATHER_API_KEY=your-openweather-key

# ========== CORS & SECURITY ==========
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,app.yourdomain.com

# ========== MONITORING & ANALYTICS ==========

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# DataDog (Monitoring)
DATADOG_API_KEY=your-datadog-key
DATADOG_SITE=datadoghq.com

# Google Analytics (Frontend)
NEXT_PUBLIC_GA_ID=G-your-ga-id

# ========== ADMIN SETTINGS ==========
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PHONE=+92300000000
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PHONE=+92300000001

# ========== FEATURE FLAGS ==========
ENABLE_MAINTENANCE_MODE=false
ENABLE_PAYMENT_SANDBOX=false
ENABLE_DEBUG_LOGS=false
ENABLE_API_DOCS=true
ENABLE_ANALYTICS=true

# ========== THIRD PARTY INTEGRATIONS ==========

# Mixpanel (Analytics)
MIXPANEL_TOKEN=your-mixpanel-token

# Intercom (Customer Support)
INTERCOM_APP_ID=your-intercom-app-id

# Slack Webhooks (Notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ========== PRODUCTION ONLY ==========
# SSL Certificate Paths (if using Node directly without Nginx)
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key

# Database Backup
BACKUP_S3_BUCKET=trucking-backups
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ========== SESSION ==========
SESSION_SECRET=your-session-secret-min-32-characters

# ========== API KEYS FOR EXTERNAL SERVICES ==========
WEATHER_API_KEY=your-weather-key
TRAFFIC_API_KEY=your-traffic-key
